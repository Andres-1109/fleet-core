PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fleetcore
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1h
API_KEYS=demo-key-partner-1,demo-key-partner-2
# Google login stays disabled (the endpoints answer 503) until real values are set.
# GOOGLE_CALLBACK_URL must be registered in Google Cloud and use the port the API is reached on.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Docker Compose only: host ports mapped to the API and PostgreSQL containers.
# Keep DB_HOST_PORT equal to DB_PORT when running the app or migrations on the host.
API_HOST_PORT=3000
DB_HOST_PORT=5432
